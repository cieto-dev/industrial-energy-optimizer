  "technology_exclusions": {
    "generic_heat_pump_for_all_chemical_processes": {
      "status": "reject",
      "reason": "Chemical manufacturing contains high-temperature processes beyond conventional heat-pump capability.",
      "replacement_rule": "Evaluate heat pumps only for measured low/medium-temperature heat duties with a suitable heat source."
    },

    "electric_boiler_for_direct_high_temperature_reaction": {
      "status": "reject",
      "reason": "An electric boiler produces steam and cannot automatically replace a direct-fired high-temperature reactor or furnace.",
      "allowed_application": "steam_generation"
    },

    "solar_thermal_for_all_process_heat": {
      "status": "reject",
      "reason": "Solar thermal is highly dependent on temperature, solar resource, operating hours and thermal storage.",
      "allowed_application": "selected low-temperature heat and preheating"
    },

    "biomass_for_all_chemical_heating": {
      "status": "reject",
      "reason": "Biomass requires verified fuel availability, quality, storage and emission compliance.",
      "allowed_application": "compatible boiler or thermal-heating systems"
    },

    "green_electricity_as_direct_fuel_replacement": {
      "status": "reject",
      "reason": "Renewable electricity can reduce emissions from electrical loads but cannot by itself replace a fossil-fuel thermal process unless an electric heating technology is installed."
    }
  },

