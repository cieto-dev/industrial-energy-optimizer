  "decision_rules": {
    "temperature_based_heat_pump": {
      "condition": "process_temperature_c <= 165",
      "action": "evaluate_heat_pump"
    },

    "temperature_based_heat_pump_pilot": {
      "condition": "165 < process_temperature_c <= 200",
      "action": "evaluate_only_if_high_temperature_heat_pump_is_verified"
    },

    "temperature_above_heat_pump_range": {
      "condition": "process_temperature_c > 200",
      "action": "exclude_conventional_heat_pump_as_primary_process_heat_source"
    },

    "electric_boiler": {
      "condition": "steam_required == true AND sufficient_electric_capacity == true",
      "action": "evaluate_electric_boiler"
    },

    "waste_heat_recovery": {
      "condition": "recoverable_waste_heat == true AND heat_sink_exists == true",
      "action": "evaluate_WHR_before_new_heat_generation"
    },

    "MVR": {
      "condition": "evaporation_or_vapor_recompression_duty == true",
      "action": "evaluate_MVR"
    },

    "electric_resistance": {
      "condition": "200 <= process_temperature_c AND process_temperature_c <= 500",
      "action": "evaluate_electric_resistance_heating"
    },

    "solar_thermal": {
      "condition": "process_temperature_c <= 200 AND solar_resource_is_sufficient == true",
      "action": "evaluate_solar_thermal"
    },

    "biomass_boiler": {
      "condition": "biomass_available == true AND biomass_quality_verified == true AND storage_available == true",
      "action": "evaluate_biomass_boiler"
    },

    "solar_pv": {
      "condition": "electric_load_kw > 0 AND suitable_site_area_available == true",
      "action": "evaluate_solar_pv"
    },

    "thermal_storage": {
      "condition": "heat_generation_and_heat_use_can_be_temporally_decoupled == true",
      "action": "evaluate_thermal_storage"
    }
  },

