        "evaluate_electric_boiler",
        "evaluate_direct_electric_heating",
        "supply_with_renewable_electricity_where_economic"
      ],
      "objective": "Replace fossil thermal energy in technically suitable low and medium temperature applications."
    },
    {
      "pathway_id": "chemical_medium_temperature_electrification",
