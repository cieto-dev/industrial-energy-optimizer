        "thermic_fluid_heater_optimization",
        "compressor_optimization",
        "pump_and_fan_VFDs",
        "process_control"
      ],
      "objective": "Reduce energy demand before replacing the energy source."
    },
    {
      "pathway_id": "chemical_waste_heat_integration",
      "priority": 2,
      "sequence": [
        "identify_waste_heat_sources",
        "measure_temperature_and_flow",
        "match_heat_source_to_sink",
        "install_heat_exchanger_or_WHR",
        "use_remaining_low_grade_heat_with_heat_pump_where_feasible"
      ],
      "objective": "Recover internally available thermal energy before generating new heat."
    },
    {
      "pathway_id": "chemical_low_temperature_electrification",
