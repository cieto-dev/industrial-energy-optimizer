      "technology_status": "various_stages",
      "source": "BEE Paper Sector Report"
    }
  },

  "decarbonization_pathways": [
    {
      "pathway_id": "paper_efficiency_first",
      "priority": 1,
      "sequence": [
        "SEC_baseline",
        "energy_monitoring",
        "boiler_optimization",
        "pump_optimization",
        "vacuum_optimization",
        "motor_efficiency",
        "steam_system_optimization"
      ],
      "objective": "Reduce specific energy consumption before fuel switching."
    },

    {
      "pathway_id": "paper_drying_efficiency",
      "priority": 2,
      "sequence": [
        "press_section_optimization",
        "shoe_press_evaluation",
        "pocket_ventilation",
        "dryer_heat_recovery",
        "thermocompressor",
        "condensate_recovery"
      ],
      "objective": "Reduce steam required to remove water from the paper web."
    },

    {
      "pathway_id": "paper_boiler_decarbonization",
      "priority": 3,
      "sequence": [
        "boiler_combustion_optimization",
        "oxygen_analyzer",
        "air_preheater",
        "economizer",
        "condensate_recovery",
        "biomass_or_residue_fuel_evaluation",
        "electric_boiler_evaluation"
      ],
      "objective": "Reduce fossil thermal energy use while preserving reliable steam production."
    },

    {
      "pathway_id": "paper_low_grade_heat_recovery",
      "priority": 4,
      "sequence": [
        "identify_low_temperature_waste_heat",
        "measure_temperature_and_flow",
        "heat_sink_matching",
        "heat_exchanger",
        "feedwater_preheating",
        "process_water_preheating",
        "sludge_drying"
      ],
      "objective": "Recover otherwise rejected low-grade heat."
    },

    {
      "pathway_id": "paper_electrical_efficiency",
      "priority": 5,
      "sequence": [
        "motor_audit",
        "pump_audit",
        "vacuum_system_audit",
        "compressed_air_audit",
        "VFD",
        "IE3_IE4_motors",
        "solar_PV"
      ],
      "objective": "Reduce electricity consumption and associated emissions."
    },

    {
      "pathway_id": "paper_circularity",
      "priority": 6,
      "sequence": [
        "increase_recovered_fibre_use_where_product_quality_allows",
        "deinking_optimization",
        "fiber_fractionation",
        "water_recycling",
        "waste_heat_reuse",
        "sludge_and_residual_utilization"
      ],
      "objective": "Reduce virgin-fibre demand, process energy and material waste."
    }
  ],

  "circular_economy_characteristics": {
    "recovered_fibre_role": "very_high",
    "india_recovered_paper_usage_reference": "BEE reports a substantially higher recycled-fibre share in Indian paper production than the global reference.",
    "india_wastepaper_recovery_rate_reference_percent": 30,
    "source": "BEE Paper Sector Report",
    "key_circular_measures": [
      "Recovered paper collection",
      "De-inking optimization",
      "Fibre fractionation",
      "Water-loop closure",
      "Sludge utilization",
      "Waste heat reuse",
      "Biomass residue utilization"
    ],
    "warning": "Increasing recovered-fibre use is constrained by feedstock quality, collection systems, contamination, price and product quality requirements."
  },

  "technology_exclusions": {
    "generic_heat_pump_for_main_paper_dryer": {
      "status": "not_default",
      "reason": "Main paper drying is a steam-dominated thermal duty and the optimizer must compare industrial heat-pump capabilities, available low-grade heat and required dryer steam conditions before considering substitution."
    },

    "solar_thermal_as_only_steam_source": {
      "status": "not_default",
      "reason": "Paper machines can operate continuously; intermittent solar heat requires storage and/or backup steam generation."
    },

    "biomass_without_feedstock_validation": {
      "status": "excluded",
      "reason": "Biomass feasibility depends on local quantity, moisture, ash, calorific value, logistics and boiler configuration."
    },

    "electric_boiler_without_grid_assessment": {
      "status": "excluded",
      "reason": "Large paper mills can have significant electrical loads. Electrification of steam generation requires transformer, contracted-demand, power-quality and tariff analysis."
    }
  },

  "optimization_rules": {
    "route_rule": {
      "mandatory_input": "paper_route",
      "possible_values": [
        "recycled_fibre",
        "agro_based",
        "wood_based_integrated",
        "standalone_paper_mill",
        "integrated_pulp_and_paper"
      ]
    },

    "benchmark_rule": {
      "rule": "Compare plants against the closest product/route benchmark rather than a single sector-wide SEC.",
      "reason": "BEE explicitly states that benchmarking different mills is difficult because paper grade, fibre source, production route and subprocesses differ."
    },

    "thermal_first_rule": {
      "priority": "very_high",
      "reason": "BEE's MSME benchmark shows thermal SEC of 0.218 toe/t versus electrical SEC of 0.033 toe/t, making thermal efficiency the dominant immediate energy-efficiency lever."
    },

    "dryer_rule": {
      "priority": "very_high",
      "actions": [
        "Optimize press dryness",
        "Evaluate shoe press",
        "Recover dryer heat",
        "Use thermocompressor where low-pressure steam exists",
        "Optimize pocket ventilation",
        "Recover condensate"
      ]
    },

    "boiler_rule": {
      "priority": "very_high",
      "actions": [
        "O2 control",
        "Air-preheater performance",
        "Economizer",
        "Flue-gas temperature",
        "Condensate recovery",
        "Insulation",
        "Fuel-air ratio"
      ]
    },

    "vacuum_rule": {
      "priority": "high",
      "actions": [
        "Measure vacuum level by section",
        "Evaluate pump loading",
        "Evaluate vacuum blower replacement",
        "Install VFD/automation when load varies"
      ]
    },

    "pump_rule": {
      "priority": "high",
      "actions": [
        "Check head",
        "Check flow",
        "Check throttling",
        "Evaluate VFD",
        "Replace oversized pumps where economically justified"
      ]
    },

    "solar_rule": {
      "priority": "medium_high",
      "application": "Electricity offset",
      "condition": "Use only after electricity-load profile and available roof/land area are measured."
    },

    "steam_pressure_rule": {
      "condition": "pressure_reduction_available",
      "action": "Evaluate back-pressure turbine or thermocompressor before wasting pressure through a PRDS, subject to process steam quality and reliability requirements."
    }
  },

