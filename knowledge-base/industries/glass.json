    },

    "biomass_boiler_for_glass_furnace": {
      "status": "excluded_as_direct_replacement",
      "reason": "A biomass boiler generates steam/hot water and does not directly replace the glass-melting furnace. Biomass may be evaluated only in furnace-compatible solid-fuel combustion systems where technically suitable."
    },

    "electric_boiler_for_melting": {
      "status": "excluded",
      "reason": "An electric boiler produces steam and cannot directly supply molten-glass melting temperature."
    },

    "electric_resistance_for_all_glass_furnaces": {
      "status": "conditional",
      "reason": "Direct electric glass melting is highly product-, furnace- and infrastructure-dependent."
    }
  },

  "optimization_rules": {
    "mandatory_route_identification": {
      "rule": "Identify glass product and furnace type before technology selection.",
      "required_inputs": [
        "Glass product",
        "Production capacity",
        "Furnace type",
        "Current fuel",
        "Cullet percentage",
        "Furnace age",
        "Furnace thermal efficiency"
      ]
    },

    "furnace_rule": {
      "priority": "very_high",
      "required_measurements": [
        "Fuel consumption",
        "Glass production",
        "Flue-gas temperature",
        "Flue-gas oxygen",
        "Combustion-air flow",
        "Furnace pressure",
        "Glass pull rate",
        "Cullet percentage"
      ]
    },

    "cullet_rule": {
      "priority": "very_high",
      "condition": "Suitable cullet available",
      "action": "Evaluate higher compatible cullet fraction before increasing furnace heat input."
    },

    "waste_heat_rule": {
      "priority": "very_high",
      "action": "Evaluate combustion-air preheating and batch preheating before installing a new standalone heat source."
    },

    "fuel_switching_rule": {
      "priority": "high",
      "condition": "Coal or pet coke is currently used",
      "sequence": [
        "Efficiency improvement",
        "Furnace heat recovery",
        "Natural gas/PNG feasibility",
        "Oxy-fuel feasibility",
        "Electric boosting",
        "Electric furnace where feasible"
      ]
    },

    "electrification_rule": {
      "condition": "Electric boosting or electric melting considered",
      "required_checks": [
        "Transformer capacity",
        "Maximum demand",
        "Power quality",
        "Electricity tariff",
        "Grid reliability",
        "Renewable electricity availability",
        "Furnace compatibility"
      ]
    },

    "solar_rule": {
      "priority": "medium",
      "application": "Auxiliary electricity and lower-temperature downstream processes",
      "warning": "Do not count solar PV as direct replacement of fossil furnace energy unless an electric furnace/boosting system is part of the pathway."
    }
  },

