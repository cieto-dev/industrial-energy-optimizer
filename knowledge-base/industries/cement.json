  "decision_rules": {
    "high_temperature_process": {
      "condition": "required_process_temperature_c > 500",
      "effect": "exclude_conventional_heat_pump_as_primary_process_heat_source"
    },

    "clinkerization": {
      "required_temperature_c": 1450,
      "effect": "retain_high_temperature_kiln_based_process"
    },

    "alternative_fuel": {
      "condition": "alternative_fuel_available == true AND fuel_quality_verified == true",
      "effect": "evaluate_thermal_substitution"
    },

    "waste_heat_recovery": {
      "condition": "recoverable_waste_heat_available == true",
      "effect": "evaluate_WHR_before_new_heat_generation"
    },

    "clinker_substitution": {
      "condition": "eligible_SCM_available == true AND product_standard_compliance == true",
      "effect": "evaluate_clinker_factor_reduction"
    },

    "solar_pv": {
      "condition": "electric_load_exists == true AND adequate_site_area == true",
      "effect": "evaluate_as_electricity_decarbonization_measure"
    },

    "ccus": {
      "condition": "large_stationary_CO2_source == true",
      "effect": "evaluate_as_long_term_decarbonization_pathway"
    }
  },

