  "technology_exclusions": {
    "heat_pump": {
      "default_status": "not_suitable_for_main_clinker_process",
      "reason": "Main clinker production requires approximately 1450 C process temperatures, far above conventional industrial heat-pump operating ranges.",
      "allowed_for_auxiliary_low_temperature_loads": true
    },

    "standard_electric_boiler": {
      "default_status": "not_suitable_for_kiln_clinkerization",
      "reason": "A conventional electric boiler produces steam and cannot directly supply the high-temperature rotary-kiln clinkerization process.",
      "allowed_for_auxiliary_steam_loads": true
    },

    "solar_thermal": {
      "default_status": "not_suitable_as_primary_kiln_heat_source",
      "reason": "Conventional solar-thermal systems cannot be assumed to deliver the continuous 1200-1450 C clinkerization duty required by a cement kiln.",
      "possible_role": [
        "low_temperature_auxiliary_heat",
        "water_heating",
        "preheating_where_site_specific_feasibility_exists"
      ]
    },

    "biomass_boiler": {
