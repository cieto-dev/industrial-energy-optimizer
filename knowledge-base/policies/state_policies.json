{
  "schema_version": "2.0",
  "file": "knowledge-base/policies/state_policies.json",
  "country": "India",
  "purpose": "State-specific industrial, MSME, energy-efficiency, clean-technology and renewable-energy incentives that can modify the financial evaluation of industrial energy-transition pathways.",
  "last_verified": "2026-08-16",

  "architecture": {
    "policy_layer": "state_policy_engine",
    "called_after": [
      "engineering_feasibility",
      "constraint_engine",
      "technology_filter",
      "scenario_generation",
      "baseline_finance"
    ],
    "called_before": [
      "final_capex_adjustment",
      "final_opex_adjustment",
      "payback_calculation",
      "roi_calculation",
      "pathway_ranking"
    ],
    "primary_input": [
      "state",
      "district",
      "block",
      "taluka",
      "enterprise_category",
      "industry_sector",
      "project_type",
      "project_status",
      "project_cost_inr",
      "fixed_capital_investment_inr",
      "loan_amount_inr",
      "annual_electricity_consumption_kwh",
      "new_or_existing",
      "expansion_or_modernization",
      "special_category"
    ]
  },

  "critical_rules": {
    "state_is_required": true,
    "district_or_taluka_required_when_policy_is_location_based": true,
    "do_not_assume_state_subsidy": true,
    "do_not_apply_expired_policy": true,
    "do_not_apply_incentive_without_eligibility_check": true,
    "do_not_double_count_central_and_state_benefits": true,
    "do_not_duplicate_electricity_tariffs": true,
    "tariffs_are_stored_elsewhere": "datasets/electricity_tariffs/",
    "tariff_master_file": "datasets/electricity_tariffs/tariff_master.csv",
    "tariff_tod_file": "datasets/electricity_tariffs/tariff_tod.csv",
    "tariff_slab_file": "datasets/electricity_tariffs/slab_rates.csv",
    "policy_engine_must_return_unknown_when_no_verified_state_rule_exists": true
  },

  "financial_treatment": {
    "capital_subsidy": {
      "effect": "reduce_eligible_capex",
      "formula": "eligible_capex_reduction = eligible_project_cost * subsidy_rate",
      "cap_required": true
    },
    "interest_subsidy": {
      "effect": "reduce_effective_financing_cost",
      "formula": "annual_interest_support = eligible_loan_amount * subsidy_rate",
      "loan_cap_required": true
    },
    "power_tariff_subsidy": {
      "effect": "reduce_electricity_opex",
      "formula": "eligible_power_cost_reduction = eligible_electricity_cost * subsidy_rate",
      "duration_required": true
    },
    "electricity_duty_exemption": {
      "effect": "reduce_electricity_opex",
      "formula": "duty_savings = eligible_electricity_duty",
      "duration_required": true
    },
    "sgst_reimbursement": {
      "effect": "state_tax_reimbursement",
      "do_not_treat_as_capex_subsidy": true,
      "do_not_treat_as_immediate_cash_at_project_start": true,
      "duration_required": true,
      "maximum_fci_cap_required": true
    },
    "stamp_duty_exemption": {
      "effect": "reduce_project_transaction_cost",
      "do_not_apply_to_energy_opex": true
    },
    "green_technology_support": {
      "effect": "reduce_eligible_clean_technology_capex",
      "eligibility_must_be_verified": true
    }
  },

  "states": {

