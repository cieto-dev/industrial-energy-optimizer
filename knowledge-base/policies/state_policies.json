      "rule": "SGST reimbursement must be modelled as a future tax-linked cashflow, not as an immediate CapEx reduction."
    },
    "interest_subsidy": {
      "rule": "Interest subsidy affects financing cost and must not be deducted from initial project CAPEX."
    },
    "electricity_duty": {
      "rule": "Electricity-duty exemption affects operating cost and must not be treated as a capital grant."
    }
