      "compliance_gap_status"
    ],
    "optional_fields": [
      "wind_component_status",
      "hydro_component_status",
      "distributed_renewable_component_status",
      "other_renewable_component_status",
      "rec_requirement",
      "buyout_cost",
      "recommended_compliance_route"
    ],
    "status_values": [
      "not_applicable",
      "compliant",
      "partially_compliant",
      "non_compliant",
      "insufficient_data"
    ]
  },

  "financial_model_rules": {
    "rpo_compliance_cost": {
      "include_in_opex": true,
      "condition": "Only when the entity is legally obligated and the pathway requires purchased RE, RECs, storage-backed renewable electricity or buyout."
    },
    "renewable_generation": {
      "do_not_double_count": true,
      "rule": "Renewable electricity generated onsite must not simultaneously be counted as both physical electricity savings and an independent REC unless the applicable REC accounting framework permits the claim."
    },
    "subsidy": {
      "rpo_is_not_subsidy": true
    },
    "capex": {
      "rpo_does_not_reduce_capex": true
    },
    "buyout": {
      "treat_as_compliance_cost": true,
      "treat_as_renewable_generation": false
    },
    "rec": {
      "treat_as_compliance_instrument": true,
      "treat_as_physical_energy_generation": false
    }
  },

  "data_quality_rules": {
    "never_assume_rpo_for_all_msmes": true,
    "never_use_old_2022_rpo_trajectory_without_checking_current_framework": true,
    "never_use_2023_rco_notification_as_current_when_2025_notification_applies": true,
    "never_mix_rpo_and_rco_without_recording_framework": true,
    "never_use_state_rpo_percentage_without_state_source": true,
    "never_calculate_compliance_without_financial_year": true,
    "never_calculate_designated_consumer_status_without_energy_consumption": true,
    "never_count_process_heat_biomass_as_renewable_electricity": true,
    "never_count_buyout_as_renewable_generation": true,
    "never_count_rec_as_physical_generation": true,
    "flag_missing_regulatory_data": true
  },

  "source_provenance": {
    "primary_sources": [
