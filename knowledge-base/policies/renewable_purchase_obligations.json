      "evaluate_buyout_option",
      "pass_compliance_result_to_finance_and_optimizer"
    ]
  },

  "pathway_relevance": {
    "solar_pv": {
      "rco_relevance": "high",
      "especially_relevant_to": [
        "distributed_renewable_component",
        "onsite renewable electricity"
      ],
      "condition": "Project capacity and applicable accounting rules must satisfy the relevant RCO category."
    },

    "wind_power": {
      "rco_relevance": "conditional",
      "condition": "For the wind component, the relevant generation must come from qualifying post-31-March-2024 wind projects."
    },

    "hydro_power": {
      "rco_relevance": "conditional",
      "condition": "For the hydro component, qualifying post-31-March-2024 hydro generation is relevant subject to the notification."
    },

    "biomass": {
      "rco_relevance": "conditional",
      "condition": "Biomass electricity may contribute where it qualifies under the applicable renewable-energy category. Biomass used only for process heat does not itself satisfy an electricity RPO/RCO requirement."
    },

    "biomass_boiler": {
      "rco_relevance": "indirect",
      "condition": "A biomass boiler producing process heat reduces fossil-fuel use but does not automatically create renewable electricity for RPO/RCO accounting."
    },

    "electric_boiler": {
      "rco_relevance": "indirect",
      "condition": "Electrification can increase electricity consumption; if the factory is an obligated/designated consumer, the increased electrical load must be reflected in the compliance calculation."
    },

    "battery_storage": {
      "rco_relevance": "supporting",
      "condition": "Storage can be used with renewable electricity for compliance where the applicable accounting framework recognises the renewable electricity consumed through storage."
    },

    "waste_heat_recovery": {
      "rco_relevance": "conditional",
      "condition": "Waste-heat recovery for process heat is not itself renewable electricity. Specific fossil-based waste-heat electricity exclusions apply for designated captive users."
    },

    "renewable_open_access": {
      "rco_relevance": "high",
      "condition": "Potentially relevant for designated open-access consumers and subject to applicable open-access and state regulatory rules."
    }
  },

