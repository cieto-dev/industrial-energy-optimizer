{
  "schema_version": "2.0",
  "file": "knowledge-base/policies/renewable_purchase_obligations.json",
  "policy_domain": "renewable_purchase_and_consumption_obligations",
  "country": "India",
  "status": "active",
  "last_verified": "2026-08-16",

  "purpose": "Regulatory knowledge used by the Industrial Energy Transition Optimizer to determine whether a factory or other electricity consumer is subject to renewable purchase/consumption obligations and whether a proposed transition pathway contributes toward compliance.",

  "architecture_role": {
    "layer": "policy_engine",
    "position_in_pipeline": [
      "factory_input",
      "engineering_models",
      "constraint_engine",
      "feasible_pathway",
      "financial_analysis",
      "policy_engine",
      "renewable_obligation_check",
      "optimizer",
      "final_recommendation"
    ],
    "primary_output": [
      "obligation_applicability",
      "applicable_target",
      "renewable_energy_requirement",
      "compliance_gap",
      "eligible_compliance_routes",
      "compliance_status"
    ]
  },

  "important_regulatory_distinction": {
    "rpo": {
      "name": "Renewable Purchase Obligation",
      "nature": "Electricity-sector regulatory obligation",
      "primary_regulators": [
        "State Electricity Regulatory Commissions",
        "Joint Electricity Regulatory Commissions",
        "Central Government where applicable"
      ],
      "important_rule": "RPO requirements are not a universal percentage applicable to every Indian MSME."
    },
    "rco": {
      "name": "Renewable Consumption Obligation",
      "legal_basis": "Energy Conservation Act, 2001 as amended by the Energy Conservation Amendment Act, 2022",
      "current_central_notification": "Ministry of Power Notification S.O. 4421(E), dated 27 September 2025",
      "scope": [
        "electricity distribution licensees",
        "designated open access consumers",
        "designated captive users"
      ],
      "important_rule": "The current central RCO framework must not be interpreted as a universal renewable-energy mandate for every MSME."
    },
    "optimizer_rule": "First determine whether the factory is an obligated entity or designated consumer. Only then calculate an RPO/RCO compliance requirement."
  },

  "applicability": {
    "default_for_msme": "not_automatically_applicable",
    "check_before_calculation": [
      "is_distribution_licensee",
      "is_designated_consumer",
      "uses_open_access",
      "uses_captive_power",
      "annual_energy_consumption",
      "industry_sector",
      "state",
      "applicable_SERC_or_JERC_regulation",
      "central_RCO_notification_applicability"
    ],
    "decision_states": [
      "not_applicable",
      "applicable",
      "conditionally_applicable",
      "insufficient_data"
    ]
  },

  "current_central_rco_framework": {
    "notification": {
      "authority": "Ministry of Power",
      "notification_number": "S.O. 4421(E)",
      "notification_date": "2025-09-27",
      "effective_framework_start": "2024-04-01",
      "supersedes": "S.O. 4617(E), dated 2023-10-20"
    },

    "covered_entities": {
      "distribution_licensees": {
        "covered": true,
        "condition": "All electricity distribution licensees designated under the applicable framework."
      },
      "open_access_consumers": {
        "covered": true,
        "condition": "Only where the consumer is a designated consumer under the Energy Conservation Act framework."
      },
      "captive_users": {
        "covered": true,
        "condition": "Only where the captive user is a designated consumer under the Energy Conservation Act framework."
      },
      "ordinary_grid_connected_msme": {
        "covered_automatically": false,
        "condition": "Ordinary electricity consumption from a distribution licensee does not by itself make an MSME an RCO-obligated entity."
      }
    },

    "target_trajectory": {
      "unit": "percentage_of_applicable_electricity_consumption",

      "2024-25": {
        "wind_percent": 0.67,
        "hydro_percent": 0.38,
        "distributed_renewable_percent": 1.50,
        "other_renewable_percent": 27.36,
        "total_renewable_percent": 29.91
      },

      "2025-26": {
        "wind_percent": 1.45,
        "hydro_percent": 1.22,
        "distributed_renewable_percent": 2.10,
        "other_renewable_percent": 28.24,
        "total_renewable_percent": 33.01
      },

      "2026-27": {
        "wind_percent": 1.97,
        "hydro_percent": 1.34,
        "distributed_renewable_percent": 2.70,
        "other_renewable_percent": 29.94,
        "total_renewable_percent": 35.95
      },

      "2027-28": {
        "wind_percent": 2.45,
        "hydro_percent": 1.42,
        "distributed_renewable_percent": 3.30,
        "other_renewable_percent": 31.64,
        "total_renewable_percent": 38.81
      },

      "2028-29": {
        "wind_percent": 2.95,
        "hydro_percent": 1.42,
        "distributed_renewable_percent": 3.90,
        "other_renewable_percent": 33.09,
        "total_renewable_percent": 41.36
      },

      "2029-30": {
        "wind_percent": 3.48,
        "hydro_percent": 1.33,
        "distributed_renewable_percent": 4.50,
        "other_renewable_percent": 34.02,
        "total_renewable_percent": 43.33
      }
    }
  },

  "rco_components": {
    "wind": {
      "component": "wind_renewable_energy",
      "target_unit": "percent",
      "eligibility_rule": "Energy from Wind Power Projects commissioned after 2024-03-31.",
      "commissioning_cutoff": "2024-03-31",
      "fungibility": "fungible_with_hydro_and_other_renewable_components",
      "project_type": "wind_power"
    },

    "hydro": {
      "component": "hydro_renewable_energy",
      "target_unit": "percent",
      "eligibility_rule": "Energy from Hydro Power Projects commissioned after 2024-03-31, subject to the notification conditions.",
      "commissioning_cutoff": "2024-03-31",
      "additional_sources": [
        "eligible_free_power from qualifying hydro projects",
        "approved hydro projects located outside India on a case-by-case basis"
      ],
      "fungibility": "fungible_with_wind_and_other_renewable_components",
      "project_type": "hydro_power"
    },

    "distributed_renewable_energy": {
      "component": "distributed_renewable_energy",
      "target_unit": "percent",
      "maximum_project_capacity_mw": 10,
      "eligible_configurations": [
        "net_metering",
        "gross_metering",
        "virtual_net_metering",
        "group_net_metering",
        "behind_the_meter",
        "other_government_notified_configurations"
      ],
      "typical_project": [
        "rooftop_solar",
        "small_distributed_renewable_project"
      ],
      "compliance_measurement": "energy_kwh",
      "fallback_generation_conversion": {
        "when_generation_data_unavailable": true,
        "multiplier_kwh_per_kw_per_day": 4
      },
      "shortfall_fungibility": "non_fungible",
      "surplus_treatment": "surplus_may_offset_other_renewable_components"
    },

    "other_renewable_energy": {
      "component": "other_renewable_energy",
      "target_unit": "percent",
      "includes": [
        "renewable_projects not classified under wind requirement",
        "renewable projects not classified under hydro requirement",
        "eligible pre-2024 hydro generation where permitted",
        "co_firing_of_eligible_biomass_pellets",
        "eligible_charcoal_from_municipal_solid_waste",
        "other renewable energy sources notified by the Central Government"
      ],
      "fungibility": "fungible_with_wind_and_hydro_components"
    }
  },

  "state_specific_rpo": {
    "principle": "RPO has historically been specified through SERC/JERC regulations and therefore state-specific rules must be consulted when the central RCO framework does not directly govern the entity.",
    "state_policy_file": "knowledge-base/policies/state_policies.json",
    "required_factory_input": "state",
    "required_regulatory_lookup": [
      "state electricity regulatory commission",
      "current renewable energy purchase obligation regulation",
      "latest amendment",
      "current financial-year target",
      "eligible renewable sources",
      "REC treatment",
      "captive/open-access applicability"
    ],
    "precedence": {
      "designated_consumer_under_current_central_rco": "apply_current_central_rco_framework",
      "other_state_obligated_entity": "apply_current_SERC_or_JERC_RPO_rule",
      "conflict": "do_not_assume; flag_for_regulatory_verification"
    },
    "important_rule": "Do not place invented state RPO percentages in this national file. State-specific targets belong in state_policies.json after verification from the applicable SERC/JERC."
  },

