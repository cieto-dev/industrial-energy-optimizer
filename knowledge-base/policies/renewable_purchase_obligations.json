  "maintenance": {
    "review_frequency": "quarterly",
    "mandatory_review_triggers": [
      "new Ministry of Power RPO/RCO notification",
      "new Electricity Amendment Rules",
      "new Energy Conservation Act notification",
      "new BEE RCO compliance procedure",
      "new CERC REC regulation",
      "new CERC RCO buyout price",
      "SERC/JERC RPO amendment",
      "new state renewable energy regulation"
    ],
    "stale_after_days": 90,
    "current_target_horizon": "2029-30",
    "rule": "If a newer official notification supersedes the current trajectory, the newest legally applicable notification must replace the older values before the optimizer uses them."
  }
