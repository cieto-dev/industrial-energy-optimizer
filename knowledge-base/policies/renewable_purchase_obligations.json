  "rco_consumption_basis": {
    "distribution_licensee": {
      "basis": "electrical_energy_supplied_to_consumers_within_distribution_licensee_periphery",
      "exclude": [
        "open_access consumption sourced outside distribution licensee",
        "electricity generated and self-consumed by captive users"
      ]
    },

    "open_access_designated_consumer": {
      "basis": "electrical_energy_consumption_at_point_of_grid_drawal",
      "scope": "electricity consumed from sources other than distribution licensee"
    },

    "captive_designated_consumer": {
      "basis": "electricity_generated_and_self_consumed",
      "exclude_auxiliary_consumption": true
    }
  },

  "captive_power_adjustments": {
    "excluded_from_obligation": [
      {
        "source": "electricity generated and self-consumed from fossil-fuel waste-heat-recovery processes",
        "exception": "WHRSG in a captive combined-cycle gas-based generating station"
      },
      {
        "source": "electricity generated and self-consumed through waste-energy recovery",
        "examples": [
          "by-product gases",
          "industrial residual energy"
        ]
      }
    ],
    "partial_exclusions": {
      "fossil_fuel_based_cogeneration": {
        "excluded_percent": 50
      },
      "aluminum_smelter_fossil_fuel_electricity": {
        "excluded_percent": 50
      }
    },
    "nuclear": {
      "excluded_from_rco_calculation": true
    }
  },

  "compliance_mechanisms": {
    "direct_renewable_consumption": {
      "allowed": true,
      "methods": [
        "onsite_renewable_generation",
        "renewable_power_purchase",
        "renewable_power_through_open_access",
        "renewable_electricity_through_energy_storage"
      ]
    },

    "renewable_energy_certificates": {
      "allowed": true,
      "instrument": "REC",
      "regulator": "Central Electricity Regulatory Commission",
      "can_include": [
        "purchased_RECs",
        "self_generated_RECs_where_allowed",
        "RECs_acquired_under_virtual_power_purchase_agreements"
      ],
      "energy_equivalence": {
        "one_rec_mwh": 1,
        "one_rec_kwh": 1000
      },
      "solar_non_solar_categories": {
        "separate_trading_categories": false,
        "reason": "CERC REC framework introduced the multiplier concept and discontinued the earlier separate solar/non-solar trading categorisation from December 2022."
      }
    },

    "energy_storage": {
      "allowed_as_compliance_route": true,
      "condition": "Renewable electricity consumed directly or through an energy storage system can contribute to RCO compliance subject to applicable accounting rules."
    },

    "virtual_power_purchase_agreement": {
      "allowed_for_rec_route": true,
      "condition": "RECs acquired under qualifying VPPAs may be used in the RCO framework."
    },

    "buyout": {
      "allowed": true,
      "regulator": "Central Electricity Regulatory Commission",
      "purpose": "Alternative compliance mechanism",
      "fund_destination": "Central Energy Conservation Fund",
      "state_fund_share_percent": 75,
      "important_rule": "Buyout is a compliance mechanism, not an energy-transition technology and must not be treated as renewable generation in the technical model."
    }
  },

  "buyout_price": {
    "currency": "INR",
    "unit": "INR_per_MWh",
    "source": "CERC Suo-Motu Order in Petition No. 12/SM/2025 dated 2026-02-18",
    "values": {
      "2024-25": 347,
      "2025-26": 347,
      "2026-27": 364,
      "2027-28": 382,
      "2028-29": 401,
      "2029-30": 421
    },
    "equivalent_inr_per_kwh": {
      "2024-25": 0.347,
      "2025-26": 0.347,
      "2026-27": 0.364,
      "2027-28": 0.382,
      "2028-29": 0.401,
      "2029-30": 0.421
    },
    "revision_rule": "CERC determined the FY 2024-25 and FY 2025-26 price at INR 347/MWh and escalated the subsequent years by 5 percent annually.",
    "review_rule": "Prices remain applicable through FY 2029-30 unless reviewed by CERC."
  },

  "compliance_calculations": {
    "total_required_renewable_energy": {
      "formula": "applicable_electricity_consumption_mwh * total_rco_percent / 100",
      "unit": "MWh_per_year"
    },

    "required_renewable_energy_kwh": {
      "formula": "applicable_electricity_consumption_kwh * total_rco_percent / 100",
      "unit": "kWh_per_year"
    },

    "compliance_gap": {
      "formula": "max(0, required_renewable_energy_mwh - eligible_renewable_energy_mwh)",
      "unit": "MWh_per_year"
    },

    "compliance_percentage": {
      "formula": "(eligible_renewable_energy_mwh / applicable_electricity_consumption_mwh) * 100",
      "unit": "percent"
    },

    "shortfall_percentage_points": {
      "formula": "max(0, target_percent - actual_eligible_renewable_share_percent)",
      "unit": "percentage_points"
    },

    "buyout_cost": {
      "formula": "rco_shortfall_mwh * applicable_buyout_price_inr_per_mwh",
      "unit": "INR_per_year",
      "important_rule": "Use only when the entity is legally eligible to use the buyout mechanism."
    },

    "rec_requirement": {
      "formula": "rco_shortfall_mwh / 1",
      "unit": "REC_units",
      "basis": "1 REC corresponds to 1 MWh of renewable electricity injected into the grid."
    }
  },

