  "schema_version": "1.0",
  "file_purpose": "Runtime financial/budget data for the Constraint Engine (feasibility) and Finance Layer (cost, savings, payback). Research narrative, caveats, and full source discussion live in sources.json / citations.json and are linked here by source_id only -- this file stays numeric and queryable.",
  "units": {
    "currency": "INR unless a unit field explicitly says otherwise (e.g. USD_per_kW)",
    "electricity_energy_charge": "INR_per_kWh",
    "electricity_fixed_charge": "INR_per_kW_month (see fixed_charge_basis if not per-kW)",
    "electricity_demand_charge": "INR_per_kVA_month",
    "fuel_price": "see unit field on each record (INR_per_tonne, INR_per_kg, INR_per_litre, INR_per_SCM)",
    "capex": "see unit field on each record (INR_per_kW, INR_per_kWh, INR_lakh, USD_per_kW, etc. -- deliberately not force-converted to a single currency; see fx_conversion_policy)",
    "opex": "INR_per_year unless stated otherwise",
    "percentage_fields": "plain percent, e.g. 5.25 means 5.25%, not a fraction",
    "lifetime": "years"
  },
  "fx_conversion_policy": "USD-denominated capex figures (WHR, thermal storage, hydrogen) are NOT converted to INR in this file. No verified INR/USD assumption was sourced for this dataset, and silently converting would present a fabricated exchange-rate assumption as sourced data. Convert at query time using a live rate.",
  "confidence_scale": {
    "high": "Primary/official source: regulator tariff order, government-notified price, or codified formula.",
    "medium": "Credible India-specific secondary source (industry report, marketplace listing, aggregator), not primary.",
    "low": "Global/non-India source, vendor-marketing claim, or single unverified source."
  },
